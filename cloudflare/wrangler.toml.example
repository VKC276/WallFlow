# Deprecated — använd wrangler.jsonc i samma mapp.
# Behålls som referens för migrate.mjs / äldre instruktioner.
#
# Kopiera ID:n från:
#   npx wrangler d1 create wallflow
#   npx wrangler kv namespace create SESSIONS
#   npx wrangler r2 bucket create wallflow-bilder
# till wrangler.jsonc (d1_databases / kv_namespaces / r2_buckets).

name = "wallflow"
main = "src/index.js"
compatibility_date = "2026-08-13"
compatibility_flags = [ "nodejs_compat" ]

[[d1_databases]]
binding = "DB"
database_name = "wallflow"
database_id = "PASTE_D1_DATABASE_ID"

[[kv_namespaces]]
binding = "SESSIONS"
id = "PASTE_KV_NAMESPACE_ID"

[[r2_buckets]]
binding = "BILDER"
bucket_name = "wallflow-bilder"
