{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wallflow",
  "main": "src/index.js",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "APP_BASE_URL": "https://wallflow.vastervikclimbing.se",
    "KIOSK_API_URL": "https://vkc-kiosk.muddy-rice-38d4.workers.dev"
  },
  // 10-kort: npx wrangler secret put ADMIN_TOKEN
  // Samma ADMIN_TOKEN som på kiosk-Workern. Inte KIOSK_TOKEN (den är bara för Pi:ns klipp).
  // Mejl: samma GAS-relay som RentR. Sätt secrets (samma värden som rentr-api):
  //   npx wrangler secret put MAIL_WEBHOOK_URL
  //   npx wrangler secret put MAIL_WEBHOOK_SECRET
  // Fyll i riktiga ID:n efter `wrangler d1 create` / `kv namespace create` (eller kör migrate.mjs).
  // Lokalt (`wrangler dev`) fungerar med placeholder-ID:n.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wallflow",
      "database_id": "28346541-e21c-435c-8407-43941e2a93e6"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "ef41bb5ed9d74b6eb68ef0e516867a43"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BILDER",
      "bucket_name": "wallflow-bilder"
    }
  ]
}
