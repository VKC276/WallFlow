{
  "name": "wallflow-cloudflare",
  "private": true,
  "version": "1.0.0",
  "description": "WallFlow Worker API (D1 + R2 + KV) — ersätter Google Apps Script",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:schema:local": "wrangler d1 execute wallflow --local --file=schema.sql",
    "db:schema:remote": "wrangler d1 execute wallflow --remote --file=schema.sql",
    "test:api": "node scripts/smoke-api.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.123.0"
  }
}
